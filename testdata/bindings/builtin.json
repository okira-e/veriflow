{
    "projectName": "Test: Builtin",
    "baseUrl": "http://localhost:8080",
    "flows": [
        {
            "name": "user-onboarding",
            "steps": [
                {
                    "name": "register",
                    "request": {
                        "method": "POST",
                        "path": "/users/register",
                        "json": {
                            "email": "test-{{RUN_ID}}@example.com",
                            "password": "P@ssw0rd!"
                        }
                    },
                    "assert": {
                        "status": 201,
                        "all": [
                            {
                                "jsonpath": "$.email",
                                "exists": true,
                                "contains": "test-{{RUN_ID}}",
                                "equals": null,
                                "secret": false
                            }
                        ]
                    },
                    "exports": {
                        "userId": "$.id"
                    }
                }
            ]
        }
    ]
}
