{
    "projectName": "Test: User Onboarding",
    "baseUrl": "http://localhost:3000/api",
    "flows": [
        {
            "name": "user-onboarding",
            "steps": [
                {
                    "name": "register",
                    "request": {
                        "method": "POST",
                        "path": "/users/register",
                        "json": {
                            "email": "test-{{RUN_ID}}@example.com",
                            "password": "P@ssw0rd!"
                        }
                    },
                    "assert": {
                        "status": 201,
                        "all": [
                            {
                                "jsonpath": "$.id",
                                "exists": true
                            }
                        ]
                    },
                    "exports": {
                        "userId": {
                            "jsonpath": "$.id"
                        }
                    }
                },
                {
                    "name": "login",
                    "request": {
                        "method": "POST",
                        "path": "/users/login",
                        "json": {
                            "email": "test-{{RUN_ID}}@example.com",
                            "password": "P@ssw0rd!"
                        }
                    },
                    "assert": {
                        "status": 200,
                        "all": [
                            {
                                "jsonpath": "$.token",
                                "exists": true
                            }
                        ]
                    },
                    "exports": {
                        "authToken": {
                            "jsonpath": "$.token",
                            "secret": true
                        }
                    }
                }
            ]
        }
    ]
}
